# --- Logging ---
# Options: error, warn, info, debug, trace
RUST_LOG="socky_be=debug,tower_http=debug"

# --- Network ---
SOCKY_NETWORK__PORT="8000"
SOCKY_NETWORK__HOST="0.0.0.0"

# --- Router ---
SOCKY_ROUTER__WEB_FOLDER="web-folder"

# --- Database ---
SOCKY_DB__USER=
SOCKY_DB__PASSWORD=
SOCKY_DB__HOST=
SOCKY_DB__NAME="socky_db"
SOCKY_DB__MAX_CONN="10"
SOCKY_DB__MIN_CONN="1"
SOCKY_DB__CONN_TIMEOUT_SECONDS="10"
SOCKY_DB__IDLE_TIMEOUT_SECONDS="0"

# --- Auth ---
SOCKY_AUTH__ACCESS_TOKEN_EXPIRATION_SECONDS="900"
SOCKY_AUTH__REFRESH_TOKEN_EXPIRATION_SECONDS="1296000"

# --- Auth Secrets ---
SOCKY_AUTH__ACCESS_TOKEN_SECRET=
SOCKY_AUTH__REFRESH_TOKEN_SECRET=
SOCKY_AUTH__REFRESH_TOKEN_PEPPER=
SOCKY_AUTH__PASSWORD_PEPPER=