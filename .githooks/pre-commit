#!/usr/bin/env bash

echo "Running pre-commit checks..."

# 1. Check code formatting
echo "-> Running cargo fmt..."
if ! cargo fmt --all -- --check; then
    echo "------------------------------------------------"
    echo "❌ Commit rejected: Code is not formatted properly."
    echo "🛠️  To fix: Run 'cargo fmt', stage your changes with 'git add', and try committing again."
    echo "------------------------------------------------"
    exit 1
fi

# 2. Check for anti-patterns and bugs
echo "-> Running cargo clippy..."
# '--all-targets' checks tests and examples, not just the main binary.
# '-D warnings' denies warnings, forcing the command to exit with an error code.
if ! cargo clippy --all-targets --all-features -- -D warnings; then
    echo "------------------------------------------------"
    echo "❌ Commit rejected: Clippy found warnings or errors."
    echo "🛠️  To fix: Resolve the Clippy suggestions above, stage your changes, and try committing again."
    echo "------------------------------------------------"
    exit 1
fi

echo "✅ All checks passed. Proceeding with commit..."
exit 0