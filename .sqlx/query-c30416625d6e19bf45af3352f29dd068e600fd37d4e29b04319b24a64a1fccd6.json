{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                t.*,\n                u.email AS user_email,\n                u.role AS \"user_role: UserRole\",\n                u.status AS \"user_status: UserStatus\"\n            FROM refresh_tokens t\n            JOIN users u ON t.user_id = u.id\n            WHERE t.token_hash = $1\n            FOR NO KEY UPDATE OF t\n            ",
