  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                id, \n                email as \"email!\", \n                username as \"username!\", \n                full_name, \n                password_hash as \"password_hash!\", \n                role as \"role!: _\", \n                status as \"status!: _\", \n                last_login_at, \n                created_at, \n                updated_at, \n                deleted_at\n            FROM users\n            WHERE id = $1\n              AND is_ghost = false\n              AND status = 1 -- Active\n            ",
